  FAIL
}

enum ArtifactReviewFrameRole {
  FIRST
  MIDDLE
  FINAL
}

enum AiQaRunStatus {
  RUNNING
  COMPLETED
  FAILED
  AMBIGUOUS
}

enum QaAdvisoryStatus {
  PASS
  WARN
  FAIL
  NOT_ASSESSABLE
}

enum HumanQaDecisionType {
  PASS
  FAIL
}

enum ContinuitySubjectKind {
  ENVIRONMENT
  CHARACTER
  PRODUCT
  PROP
  CAMERA
  VISUAL_STYLE
}

enum ContinuityPolicy {
  WHOLE_FILM_HOLD
  SHOT_CHANGE
  UNIMPORTANT
}

enum ContinuityImportance {
  HARD
  SOFT
}

enum ContinuityDecisionType {
  APPROVED
  REJECTED
  REVOKED
}

enum KeyframePlanStatus {
  PLANNED
  RUNNING
  PAUSED
  AWAITING_REVIEW
  APPROVED
  REJECTED
}

enum KeyframeAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
  AMBIGUOUS
}

enum KeyframeDecisionType {
  APPROVED
  REJECTED
}

enum VideoControlTier {
  ORDINARY_REFERENCE
  LOCKED_START
  LOCKED_START_END
}

enum GenerationExecutorType {
  COMFYUI_GRAPH
  DIRECT_PROVIDER_API
}

enum GenerationImplementationStatus {
  DISCOVERED
  TRIAL
  READY
  BLOCKED
  RETIRED
}

enum GenerationEvidenceSourceType {
  REAL_GENERATION_JOB
  LEGACY_REAL_ARTIFACT
  STATIC_VALIDATION
  READINESS
}

enum GenerationTechnicalResult {
  TECHNICALLY_VALID
  TECHNICAL_FAILED
  AMBIGUOUS
}

enum ShotExecutionPlanLifecycle {
  DRAFT
  FROZEN
  INVALIDATED
  SUPERSEDED
}

enum ShotPlanningOutcome {
  READY
  TRIAL
  BLOCKED
  WAITING_FOR_UPSTREAM_REPAIR
}

enum GenerationExecutionDisposition {
  EXECUTE
  REUSE_ARTIFACT
}

enum GenerationEngineVersion {
  LEGACY_V1
  WORKFLOW_AGENT_V1
}

enum QaContinuationMode {
  AUTO_CONTINUE_AFTER_QA_PASS
  PAUSE_AFTER_EACH_SHOT
