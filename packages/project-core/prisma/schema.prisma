generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum StoryboardStatus {
  ACTIVE
  ARCHIVED
}

enum TargetAspectRatio {
  PORTRAIT_9_16
  LANDSCAPE_16_9
  SQUARE_1_1
  PORTRAIT_4_5
}

enum VerificationStatus {
  PRESERVED
  VERIFIED
  INVALID
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum AssetRole {
  SCENE
  PRODUCT
  CHARACTER_FULL_BODY
  CHARACTER_FACE
  CHARACTER_REAR_SIDE
  PROP
  AUDIO
  OTHER
}

enum AssetStatus {
  PRESERVED
  READY
  INVALID
  REMOVED
}

enum ImportOutcome {
  IMPORTED
  DUPLICATE
  REJECTED
  FAILED
}

enum ImportAttemptStatus {
  PROCESSING
  TERMINAL
}

enum ImportBatchStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum ProbeStatus {
  PASS
  FAIL
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  ASSET_IMPORTED
  ASSET_UPDATED
  ASSET_REMOVED
  ASSET_REVALIDATED
  PRODUCTION_ASSET_CREATED
  PRODUCTION_ASSET_PUBLISHED
  CHARACTER_STATE_PUBLISHED
  ASSET_VERSION_FILE_BOUND
  UNDERSTANDING_APPLIED
}

enum ProductionAssetType {
  CHARACTER
  OUTFIT
  PROP
  SCENE
  VOICE
  LORA
  HAIR
  MAKEUP
  ACCESSORY
  OTHER
}

enum ProductionAssetStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductionAssetVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ReferenceUsage {
  IDENTITY
  FACE
  FULL_BODY
  OUTFIT_DETAIL
  PROP_DETAIL
  SCENE_STYLE
  POSE
  CONTROL
  TRAINING_SOURCE
}

enum Viewpoint {
  FRONT
  FRONT_THREE_QUARTER
  SIDE
  REAR_THREE_QUARTER
  REAR
  TOP
  LOW
  DETAIL
  UNSPECIFIED
}

enum ShotScale {
  EXTREME_CLOSE_UP
  CLOSE_UP
  MEDIUM_CLOSE_UP
  MEDIUM
  MEDIUM_FULL
  FULL
  WIDE
  EXTREME_WIDE
  UNSPECIFIED
