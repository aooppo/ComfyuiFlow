}

model GenerationPlanAssemblySource {
  id                       String                 @id @default(uuid()) @db.Uuid
  projectId                String                 @db.Uuid
  generationPlanAssemblyId String                 @db.Uuid
  generationSpecId         String                 @db.Uuid
  generatedArtifactId      String                 @db.Uuid
  ordinal                  Int
  sourceSha256             String                 @db.Char(64)
  sourceByteSize           BigInt
  sourceMimeType           String                 @db.VarChar(120)
  createdAt                DateTime               @default(now())
  project                  Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  generationPlanAssembly   GenerationPlanAssembly @relation(fields: [generationPlanAssemblyId], references: [id], onDelete: Restrict)
  generationSpec           GenerationSpec         @relation(fields: [generationSpecId], references: [id], onDelete: Restrict)
  generatedArtifact        GeneratedArtifact      @relation(fields: [generatedArtifactId], references: [id], onDelete: Restrict)

  @@unique([generationPlanAssemblyId, ordinal])
  @@unique([generationPlanAssemblyId, generationSpecId])
  @@unique([projectId, id])
  @@index([generatedArtifactId])
}
