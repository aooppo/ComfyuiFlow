enum BindingApprovalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BindingSourceType {
  OWNER
  MIGRATION
  UNDERSTANDING_REVISION
}

enum BindingStatus {
  ACTIVE
  INACTIVE
}

enum AssetRelationType {
  DEFAULT_VOICE
  IDENTITY_LORA
  REQUIRES
  COMPATIBLE_WITH
  PART_OF
  DERIVED_FROM
}

enum RelationStatus {
  ACTIVE
  INACTIVE
}

enum CharacterStateComponentSlot {
  OUTFIT
  HAIR
  MAKEUP
  ACCESSORY
}

enum AnalysisGrantStatus {
  CREATED
  CONSUMED
  EXPIRED
}

enum AnalysisRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  AMBIGUOUS
}

enum ProviderAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
  AMBIGUOUS
}

enum UnderstandingAuthorType {
  MACHINE
  OWNER
}

enum UnderstandingReviewDecision {
  ACCEPTED
  REJECTED
}

enum UnderstandingApplicationTarget {
  PRODUCTION_ASSET_DRAFT
  ASSET_VERSION_FILE_DRAFT
}

enum StoryboardVersionSource {
  OWNER
  FAKE_DIRECTOR
  AI_DIRECTOR
}

enum StoryboardDirectorRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  AMBIGUOUS
}

enum StoryboardDirectorAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
  AMBIGUOUS
}

enum StoryboardDirectorProposalDecisionType {
  REJECTED
  ADOPTED
}

enum StoryboardDecisionType {
  APPROVED
  REVOKED
}

enum GenerationPlanVersionSource {
  DETERMINISTIC_PLANNER
  OWNER
}

enum GenerationPlanDecisionType {
  APPROVED
  REVOKED
}

enum GenerationBatchStatus {
  QUEUED
  RUNNING
  PAUSED
  AWAITING_HUMAN_QA
  COMPLETED
  CANCELLED
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  SUBMITTED
  AMBIGUOUS
  TECHNICAL_FAILED
  AWAITING_HUMAN_QA
  QA_PASS
  QA_FAIL
  CANCELLED
}

enum ExecutionOperation {
  GENERATION_SUBMIT
  AI_QA_REVIEW
}

enum GeneratedArtifactStatus {
  RETAINED
  TECHNICALLY_VALID
  TECHNICALLY_INVALID
}

enum TechnicalCheckStatus {
