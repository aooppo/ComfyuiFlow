generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum StoryboardStatus {
  ACTIVE
  ARCHIVED
}

enum AssetStatus {
  PRESERVED
  READY
  INVALID
  REMOVED
}

enum GenerationAttemptState {
  QUEUED
  LEASED
  SUBMITTING
  SUBMITTED
  RECONCILING
  COMPLETED
  FAILED
  AMBIGUOUS
  CANCELLED
}

enum AuthorizationState {
  ACTIVE
  CONSUMED
  EXPIRED
  CANCELLED
}

enum OwnerDecisionType {
  PASS
  FAIL
  RISK_ACCEPTED
}

enum GraphValidationOutcome {
  PASS
  FAIL
}

model Project {
  id              String                      @id @default(uuid()) @db.Uuid
  name            String                      @db.VarChar(240)
  status          ProjectStatus               @default(ACTIVE)
  createdAt       DateTime                    @default(now()) @db.Timestamptz(6)
  assets          Asset[]
  storyboards     Storyboard[]
  requirements    ShotGenerationRequirement[]
  generationPlans GenerationPlan[]
  assemblies      GenerationAssembly[]
}

model Asset {
  id         String      @id @default(uuid()) @db.Uuid
  projectId  String      @db.Uuid
  storageKey String      @unique @db.VarChar(500)
  sha256     String      @db.Char(64)
  mediaType  String      @db.VarChar(40)
  status     AssetStatus @default(PRESERVED)
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

model Storyboard {
  id        String              @id @default(uuid()) @db.Uuid
  projectId String              @db.Uuid
  title     String              @db.VarChar(240)
  status    StoryboardStatus    @default(ACTIVE)
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versions  StoryboardVersion[]

  @@index([projectId, createdAt])
}

model StoryboardVersion {
  id           String                      @id @default(uuid()) @db.Uuid
  storyboardId String                      @db.Uuid
  ordinal      Int
  payloadJson  Json
  digest       String                      @db.Char(64)
  createdAt    DateTime                    @default(now()) @db.Timestamptz(6)
  storyboard   Storyboard                  @relation(fields: [storyboardId], references: [id], onDelete: Restrict)
  shots        StoryboardShot[]
  requirements ShotGenerationRequirement[]

  @@unique([storyboardId, ordinal])
  @@unique([storyboardId, digest])
}

model StoryboardShot {
  id                  String                      @id @default(uuid()) @db.Uuid
  storyboardVersionId String                      @db.Uuid
  ordinal             Int
  payloadJson         Json
  digest              String                      @db.Char(64)
  createdAt           DateTime                    @default(now()) @db.Timestamptz(6)
  storyboardVersion   StoryboardVersion           @relation(fields: [storyboardVersionId], references: [id], onDelete: Restrict)
  requirements        ShotGenerationRequirement[]

  @@unique([storyboardVersionId, ordinal])
  @@unique([storyboardVersionId, digest])
}

model CapabilityProfile {
  id               String                     @id @default(uuid()) @db.Uuid
  ref              String                     @db.VarChar(160)
  version          String                     @db.VarChar(80)
  schemaVersion    Int                        @default(1)
  payloadJson      Json
  digest           String                     @db.Char(64)
  createdAt        DateTime                   @default(now()) @db.Timestamptz(6)
  runtimeContracts RuntimeContract[]
  implementations  GenerationImplementation[]
  publicationReceipts CapabilityPublicationReceipt[]

  @@unique([ref, version])
}

model RuntimeContract {
  id                  String                     @id @default(uuid()) @db.Uuid
  capabilityProfileId String                     @db.Uuid
  ref                 String                     @db.VarChar(160)
  version             String                     @db.VarChar(80)
  nodeClassesJson     Json
  digest              String                     @db.Char(64)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(6)
  capabilityProfile   CapabilityProfile          @relation(fields: [capabilityProfileId], references: [id], onDelete: Restrict)
  implementations     GenerationImplementation[]
  specs               GenerationSpec[]

  @@unique([ref, version])
}

model GenerationImplementation {
  id                  String            @id @default(uuid()) @db.Uuid
  capabilityProfileId String            @db.Uuid
  runtimeContractId   String            @db.Uuid
  ref                 String            @db.VarChar(160)
  version             String            @db.VarChar(80)
  providerRef         Json
  modelRef            Json
  adapterRef          Json
  compilerRef         Json
  validatorRef        Json
  lifecycle           String            @db.VarChar(20)
  digest              String            @db.Char(64)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  capabilityProfile   CapabilityProfile @relation(fields: [capabilityProfileId], references: [id], onDelete: Restrict)
  runtimeContract     RuntimeContract   @relation(fields: [runtimeContractId], references: [id], onDelete: Restrict)
  specs               GenerationSpec[]
  publicationReceipts CapabilityPublicationReceipt[]

  @@unique([ref, version])
}

model CapabilityPublicationReceipt {
  id                  String                   @id @default(uuid()) @db.Uuid
  actorRef            String                   @db.VarChar(160)
  manifestJson        Json
  manifestSha256      String                   @unique @db.Char(64)
  capabilityProfileId String                   @db.Uuid
  implementationId    String                   @db.Uuid
  receiptDigest       String                   @unique @db.Char(64)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(6)
  capabilityProfile   CapabilityProfile        @relation(fields: [capabilityProfileId], references: [id], onDelete: Restrict)
  implementation      GenerationImplementation @relation(fields: [implementationId], references: [id], onDelete: Restrict)

  @@index([capabilityProfileId, createdAt])
  @@index([implementationId, createdAt])
}

model ShotGenerationRequirement {
  id                  String                  @id @default(uuid()) @db.Uuid
  projectId           String                  @db.Uuid
  storyboardVersionId String                  @db.Uuid
  shotId              String                  @db.Uuid
  payloadJson         Json
  digest              String                  @db.Char(64)
  createdAt           DateTime                @default(now()) @db.Timestamptz(6)
  project             Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  storyboardVersion   StoryboardVersion       @relation(fields: [storyboardVersionId], references: [id], onDelete: Restrict)
  shot                StoryboardShot          @relation(fields: [shotId], references: [id], onDelete: Restrict)
  snapshots           PlanningInputSnapshot[]

  @@unique([shotId, digest])
}

model PlanningInputSnapshot {
  id            String                    @id @default(uuid()) @db.Uuid
  requirementId String                    @db.Uuid
  payloadJson   Json
  digest        String                    @db.Char(64)
  createdAt     DateTime                  @default(now()) @db.Timestamptz(6)
  requirement   ShotGenerationRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  specs         GenerationSpec[]

  @@unique([requirementId, digest])
}

model GenerationSpec {
  id                      String                     @id @default(uuid()) @db.Uuid
  planningInputSnapshotId String                     @db.Uuid
  implementationId        String                     @db.Uuid
  runtimeContractId       String                     @db.Uuid
  payloadJson             Json
  digest                  String                     @db.Char(64)
  createdAt               DateTime                   @default(now()) @db.Timestamptz(6)
  planningInputSnapshot   PlanningInputSnapshot      @relation(fields: [planningInputSnapshotId], references: [id], onDelete: Restrict)
  implementation          GenerationImplementation   @relation(fields: [implementationId], references: [id], onDelete: Restrict)
  runtimeContract         RuntimeContract            @relation(fields: [runtimeContractId], references: [id], onDelete: Restrict)
  referencePlan           ReferencePlan?
  graphSnapshot           MaterializedGraphSnapshot?
  targets                 GenerationTarget[]

  @@unique([planningInputSnapshotId, digest])
}

model ReferencePlan {
  id               String                      @id @default(uuid()) @db.Uuid
  generationSpecId String                      @unique @db.Uuid
  payloadJson      Json
  digest           String                      @unique @db.Char(64)
  createdAt        DateTime                    @default(now()) @db.Timestamptz(6)
  generationSpec   GenerationSpec              @relation(fields: [generationSpecId], references: [id], onDelete: Restrict)
  graphSnapshots   MaterializedGraphSnapshot[]
}

model MaterializedGraphSnapshot {
  id                    String         @id @default(uuid()) @db.Uuid
  generationSpecId      String         @unique @db.Uuid
  referencePlanId       String         @db.Uuid
  graphJson             Json
  graphSha256           String         @unique @db.Char(64)
  runtimeContractDigest String         @db.Char(64)
  outputNodeId          String         @db.VarChar(160)
  outputMediaKey        String         @db.VarChar(160)
  createdAt             DateTime       @default(now()) @db.Timestamptz(6)
  generationSpec        GenerationSpec @relation(fields: [generationSpecId], references: [id], onDelete: Restrict)
  referencePlan         ReferencePlan  @relation(fields: [referencePlanId], references: [id], onDelete: Restrict)
  validationEvidence    GraphValidationEvidence[]
}

model GraphValidationEvidence {
  id                       String                 @id @default(uuid()) @db.Uuid
  graphSnapshotId          String                 @db.Uuid
  graphSha256              String                 @db.Char(64)
  runtimeContractDigest    String                 @db.Char(64)
  runtimeFingerprintSha256 String?                @db.Char(64)
  nodeCatalogSha256        String?                @db.Char(64)
  validatorRef             String                 @db.VarChar(160)
  validatorVersion         String                 @db.VarChar(80)
  outcome                  GraphValidationOutcome
  diagnosticsJson          Json
  createdAt                DateTime               @default(now()) @db.Timestamptz(6)
  graphSnapshot            MaterializedGraphSnapshot @relation(fields: [graphSnapshotId], references: [id], onDelete: Restrict)
  attempts                 GenerationAttempt[]

  @@index([graphSnapshotId, outcome, createdAt])
  @@index([graphSha256, runtimeContractDigest, outcome, createdAt])
}

model GenerationPlan {
  id             String                    @id @default(uuid()) @db.Uuid
  projectId      String                    @db.Uuid
  payloadJson    Json
  digest         String                    @db.Char(64)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(6)
  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  authorizations GenerationAuthorization[]
  batches        GenerationBatch[]

  @@unique([projectId, digest])
}

model GenerationAuthorization {
  id                    String                     @id @default(uuid()) @db.Uuid
  generationPlanId      String                     @db.Uuid
  scopeJson             Json
  generationLimit       Int
  aiQaLimit             Int
  generationPriceMicros BigInt?
  aiQaPriceMicros       BigInt?
  expiresAt             DateTime                   @db.Timestamptz(6)
  state                 AuthorizationState         @default(ACTIVE)
  createdAt             DateTime                   @default(now()) @db.Timestamptz(6)
  generationPlan        GenerationPlan             @relation(fields: [generationPlanId], references: [id], onDelete: Restrict)
  batch                 GenerationBatch?
  consumptions          AuthorizationConsumption[]
}

model GenerationBatch {
  id               String                  @id @default(uuid()) @db.Uuid
  generationPlanId String                  @db.Uuid
  authorizationId  String                  @unique @db.Uuid
  idempotencyKey   String                  @unique @db.VarChar(160)
  createdAt        DateTime                @default(now()) @db.Timestamptz(6)
  generationPlan   GenerationPlan          @relation(fields: [generationPlanId], references: [id], onDelete: Restrict)
  authorization    GenerationAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  targets          GenerationTarget[]
}

model GenerationTarget {
  id                String             @id @default(uuid()) @db.Uuid
  generationBatchId String             @db.Uuid
  generationSpecId  String             @db.Uuid
  ordinal           Int
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  generationBatch   GenerationBatch    @relation(fields: [generationBatchId], references: [id], onDelete: Restrict)
  generationSpec    GenerationSpec     @relation(fields: [generationSpecId], references: [id], onDelete: Restrict)
  attempt           GenerationAttempt?

  @@unique([generationBatchId, ordinal])
}

model GenerationAttempt {
  id                    String                     @id @default(uuid()) @db.Uuid
  generationTargetId    String                     @unique @db.Uuid
  adapterRef            Json
  runtimeRef            Json
  runtimeContractDigest String                     @db.Char(64)
  graphSha256           String                     @db.Char(64)
  graphValidationEvidenceId String?                @db.Uuid
  state                 GenerationAttemptState     @default(QUEUED)
  providerTaskId        String?                    @unique @db.VarChar(500)
  terminalCode          String?                    @db.VarChar(160)
  createdAt             DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                   @default(now()) @db.Timestamptz(6)
  generationTarget      GenerationTarget           @relation(fields: [generationTargetId], references: [id], onDelete: Restrict)
  graphValidationEvidence GraphValidationEvidence? @relation(fields: [graphValidationEvidenceId], references: [id], onDelete: Restrict)
  events                GenerationAttemptEvent[]
  consumptions          AuthorizationConsumption[]
  artifact              GenerationArtifact?
}

model GenerationAttemptEvent {
  id        String                 @id @default(uuid()) @db.Uuid
  attemptId String                 @db.Uuid
  state     GenerationAttemptState
  taskId    String?                @db.VarChar(500)
  code      String?                @db.VarChar(160)
  createdAt DateTime               @default(now()) @db.Timestamptz(6)
  attempt   GenerationAttempt      @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([attemptId, state, createdAt])
}

model AuthorizationConsumption {
  id              String                  @id @default(uuid()) @db.Uuid
  authorizationId String                  @db.Uuid
  attemptId       String                  @db.Uuid
  operation       String                  @db.VarChar(20)
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  authorization   GenerationAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  attempt         GenerationAttempt       @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  aiQaRun         AiQaRun?

  @@unique([attemptId, operation])
}

model GenerationArtifact {
  id             String            @id @default(uuid()) @db.Uuid
  attemptId      String            @unique @db.Uuid
  storageKey     String            @unique @db.VarChar(500)
  sha256         String            @db.Char(64)
  ffprobeJson    Json
  framesJson     Json
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  attempt        GenerationAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  aiQaRuns       AiQaRun[]
  ownerDecisions OwnerDecision[]
}

model AiQaRun {
  id                         String                   @id @default(uuid()) @db.Uuid
  artifactId                 String                   @db.Uuid
  authorizationConsumptionId String                   @unique @db.Uuid
  state                      String                   @db.VarChar(20)
  createdAt                  DateTime                 @default(now()) @db.Timestamptz(6)
  artifact                   GenerationArtifact       @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  authorizationConsumption   AuthorizationConsumption @relation(fields: [authorizationConsumptionId], references: [id], onDelete: Restrict)
  result                     AiQaResult?
}

model AiQaResult {
  id          String   @id @default(uuid()) @db.Uuid
  aiQaRunId   String   @unique @db.Uuid
  payloadJson Json
  digest      String   @db.Char(64)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  aiQaRun     AiQaRun  @relation(fields: [aiQaRunId], references: [id], onDelete: Restrict)
}

model OwnerDecision {
  id             String             @id @default(uuid()) @db.Uuid
  artifactId     String             @db.Uuid
  decision       OwnerDecisionType
  actorRef       String             @db.VarChar(160)
  idempotencyKey String             @unique @db.VarChar(160)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  artifact       GenerationArtifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  retryPreview   RetryPreview?
}

model RetryPreview {
  id              String        @id @default(uuid()) @db.Uuid
  ownerDecisionId String        @unique @db.Uuid
  payloadJson     Json
  digest          String        @unique @db.Char(64)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  ownerDecision   OwnerDecision @relation(fields: [ownerDecisionId], references: [id], onDelete: Restrict)
}

model GenerationAssembly {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  inputDigest    String   @unique @db.Char(64)
  idempotencyKey String   @unique @db.VarChar(160)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
}
