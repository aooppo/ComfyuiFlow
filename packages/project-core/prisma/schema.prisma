  id                    String              @id @default(uuid()) @db.Uuid
  keyframePlanVersionId String              @db.Uuid
  shotBoundaryId        String              @db.Uuid
  boundaryIndex         Int
  stateHash             String              @db.Char(64)
  referencesJson        Json
  referencesHash        String              @db.Char(64)
  prompt                String
  promptHash            String              @db.Char(64)
  targetHash            String              @db.Char(64)
  createdAt             DateTime            @default(now())
  keyframePlanVersion   KeyframePlanVersion @relation(fields: [keyframePlanVersionId], references: [id], onDelete: Restrict)
  shotBoundary          ShotBoundary        @relation(fields: [shotBoundaryId], references: [id], onDelete: Restrict)
  attempts              KeyframeAttempt[]

  @@unique([keyframePlanVersionId, boundaryIndex])
  @@unique([keyframePlanVersionId, shotBoundaryId])
  @@unique([keyframePlanVersionId, targetHash])
}

model KeyframeAuthorization {
  id                    String              @id @default(uuid()) @db.Uuid
  projectId             String              @db.Uuid
  keyframePlanVersionId String              @unique @db.Uuid
  planHash              String              @db.Char(64)
  maximumCalls          Int
  idempotencyKey        String              @unique @db.VarChar(120)
  confirmedAt           DateTime
  expiresAt             DateTime
  createdAt             DateTime            @default(now())
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  keyframePlanVersion   KeyframePlanVersion @relation(fields: [keyframePlanVersionId], references: [id], onDelete: Restrict)
  attempts              KeyframeAttempt[]

  @@unique([projectId, id])
  @@index([projectId, expiresAt])
}

model KeyframeAttempt {
  id                      String                @id @default(uuid()) @db.Uuid
  projectId               String                @db.Uuid
  keyframeAuthorizationId String                @db.Uuid
  keyframeTargetId        String                @db.Uuid
  providerId              String                @db.VarChar(80)
  modelSnapshot           String                @db.VarChar(160)
  requestHash             String                @db.Char(64)
  status                  KeyframeAttemptStatus @default(STARTED)
  safeResultCode          String                @db.VarChar(80)
  providerCallCount       Int                   @default(0)
  usageJson               Json?
  costFactsJson           Json?
  responseId              String?               @db.VarChar(255)
  createdAt               DateTime              @default(now())
  finishedAt              DateTime?
  project                 Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  keyframeAuthorization   KeyframeAuthorization @relation(fields: [keyframeAuthorizationId], references: [id], onDelete: Restrict)
  keyframeTarget          KeyframeTarget        @relation(fields: [keyframeTargetId], references: [id], onDelete: Restrict)
  artifact                KeyframeArtifact?

  @@unique([keyframeAuthorizationId, keyframeTargetId])
  @@unique([projectId, id])
  @@index([keyframeAuthorizationId, createdAt])
}

model KeyframeArtifact {
  id                String             @id @default(uuid()) @db.Uuid
  projectId         String             @db.Uuid
  keyframeAttemptId String             @unique @db.Uuid
  storageKey        String             @db.VarChar(255)
  sha256            String             @db.Char(64)
  byteSize          BigInt
  detectedMimeType  String             @db.VarChar(120)
  width             Int
  height            Int
  retainedAt        DateTime           @default(now())
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  keyframeAttempt   KeyframeAttempt    @relation(fields: [keyframeAttemptId], references: [id], onDelete: Restrict)
  decisions         KeyframeDecision[]

  @@unique([projectId, id])
  @@index([storageKey])
}

model KeyframeDecision {
  id                 String               @id @default(uuid()) @db.Uuid
  projectId          String               @db.Uuid
  keyframeArtifactId String               @db.Uuid
  decision           KeyframeDecisionType
  idempotencyKey     String               @unique @db.VarChar(120)
  notes              String?
  createdAt          DateTime             @default(now())
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  keyframeArtifact   KeyframeArtifact     @relation(fields: [keyframeArtifactId], references: [id], onDelete: Restrict)

  @@unique([projectId, id])
  @@index([keyframeArtifactId, createdAt(sort: Desc)])
}

model GenerationPlanDraft {
  id                      String                      @id @default(uuid()) @db.Uuid
  projectId               String                      @db.Uuid
  generationPlanId        String                      @db.Uuid
  generationPlanVersionId String                      @db.Uuid
  sourceSetHash           String                      @db.Char(64)
  warningsJson            Json
  warningsHash            String                      @db.Char(64)
  storageKey              String                      @db.VarChar(255)
  sha256                  String                      @db.Char(64)
  byteSize                BigInt
  detectedMimeType        String                      @db.VarChar(120)
  container               String                      @db.VarChar(80)
  videoCodec              String                      @db.VarChar(80)
  width                   Int
  height                  Int
  fps                     Float
  durationSeconds         Float
  hasAudio                Boolean                     @default(false)
  assemblerVersion        String                      @db.VarChar(80)
  createdAt               DateTime                    @default(now())
  project                 Project                     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  generationPlan          GenerationPlan              @relation(fields: [generationPlanId], references: [id], onDelete: Restrict)
  generationPlanVersion   GenerationPlanVersion       @relation(fields: [generationPlanVersionId], references: [id], onDelete: Restrict)
  sources                 GenerationPlanDraftSource[]

  @@unique([generationPlanVersionId, sourceSetHash, warningsHash])
  @@unique([projectId, id])
  @@index([generationPlanId, createdAt(sort: Desc)])
}

model GenerationPlanDraftSource {
  id                    String              @id @default(uuid()) @db.Uuid
  projectId             String              @db.Uuid
  generationPlanDraftId String              @db.Uuid
  generationSpecId      String              @db.Uuid
  generatedArtifactId   String              @db.Uuid
  ordinal               Int
  sourceSha256          String              @db.Char(64)
  sourceByteSize        BigInt
  sourceMimeType        String              @db.VarChar(120)
  humanQaState          String              @db.VarChar(40)
  warningsJson          Json
  createdAt             DateTime            @default(now())
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  generationPlanDraft   GenerationPlanDraft @relation(fields: [generationPlanDraftId], references: [id], onDelete: Restrict)
  generationSpec        GenerationSpec      @relation(fields: [generationSpecId], references: [id], onDelete: Restrict)
  generatedArtifact     GeneratedArtifact   @relation(fields: [generatedArtifactId], references: [id], onDelete: Restrict)

  @@unique([generationPlanDraftId, ordinal])
  @@unique([generationPlanDraftId, generationSpecId])
  @@unique([projectId, id])
  @@index([generatedArtifactId])
}
