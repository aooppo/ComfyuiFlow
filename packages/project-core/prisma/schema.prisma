enum StoryboardDirectorRunKind {
  STORYBOARD
  SHOT_REPAIR
}

enum RepairAction {
  CHANGE_IMPLEMENTATION
  RELAX_REQUIREMENT
  REWRITE_SHOT
  SPLIT_SHOT
  REPLACE_ASSET
}

model Project {
  id                                  String                               @id @default(uuid()) @db.Uuid
  name                                String                               @db.VarChar(120)
  brief                               String?
  targetAspectRatio                   TargetAspectRatio
  status                              ProjectStatus                        @default(ACTIVE)
  archivedAt                          DateTime?
  createdAt                           DateTime                             @default(now())
  updatedAt                           DateTime                             @updatedAt
  generationDefaultsJson              Json?
  generationPolicyJson                Json?
  continuationMode                    QaContinuationMode                   @default(AUTO_CONTINUE_AFTER_QA_PASS)
  maximumGenerationCostMicros         BigInt?
  generationCostCurrency              String?                              @db.Char(3)
  assets                              Asset[]
  importAttempts                      AssetImportAttempt[]
  importBatches                       AssetImportBatch[]
  activities                          ProjectActivity[]
  productionAssets                    ProductionAsset[]
  characterProfiles                   CharacterProfile[]
  analysisManifests                   AssetUnderstandingManifest[]
  analysisRuns                        AssetUnderstandingRun[]
  storyboards                         Storyboard[]
  storyboardVersions                  StoryboardVersion[]
  storyboardRuns                      StoryboardDirectorRun[]
  storyboardDirectorReferences        StoryboardDirectorInputReference[]
  storyboardDirectorAuthorizations    StoryboardDirectorAuthorization[]
  storyboardDirectorAttempts          StoryboardDirectorAttempt[]
  storyboardDirectorProposals         StoryboardDirectorProposal[]
  storyboardDirectorProposalDecisions StoryboardDirectorProposalDecision[]
  shotAssetBindings                   ShotAssetBinding[]
  resolutionManifests                 AssetResolutionManifest[]
  storyboardDecisions                 StoryboardDecision[]
  generationPlans                     GenerationPlan[]
  generationPlanVersions              GenerationPlanVersion[]
  generationSpecs                     GenerationSpec[]
  generationSpecReferences            GenerationSpecReference[]
  generationPlanDecisions             GenerationPlanDecision[]
  generationBatches                   GenerationBatch[]
  generationBatchTargets              GenerationBatchTarget[]
  executionAuthorizations             ExecutionAuthorization[]
  authorizationConsumptions           AuthorizationConsumption[]
  generationJobs                      GenerationJob[]
  generatedArtifacts                  GeneratedArtifact[]
  aiQaRuns                            AiQaRun[]
  humanQaDecisions                    HumanQaDecision[]
  generationPlanAssemblies            GenerationPlanAssembly[]
  generationAssemblySources           GenerationPlanAssemblySource[]
  continuityProfiles                  ContinuityProfile[]
  continuityProfileVersions           ContinuityProfileVersion[]
  continuitySubjects                  ContinuitySubject[]
  continuityDecisions                 ContinuityDecision[]
  keyframePlans                       KeyframePlanVersion[]
  keyframeAuthorizations              KeyframeAuthorization[]
  keyframeAttempts                    KeyframeAttempt[]
  keyframeArtifacts                   KeyframeArtifact[]
  keyframeDecisions                   KeyframeDecision[]
  generationPlanDrafts                GenerationPlanDraft[]
  generationDraftSources              GenerationPlanDraftSource[]
  shotExecutionPlans                  ShotExecutionPlan[]

  @@index([status, updatedAt(sort: Desc)])
}

model StoredObject {
  id                 String             @id @default(uuid()) @db.Uuid
  sha256             String             @unique @db.Char(64)
  byteSize           BigInt
  detectedMimeType   String             @db.VarChar(120)
  storageKey         String             @unique @db.VarChar(255)
  verificationStatus VerificationStatus @default(PRESERVED)
  createdAt          DateTime           @default(now())
  verifiedAt         DateTime?
  assets             Asset[]
  probeResults       MediaProbeResult[]
}

model MediaProbeResult {
  id             String       @id @default(uuid()) @db.Uuid
  storedObjectId String       @db.Uuid
  ordinal        Int
  probeVersion   String       @db.VarChar(80)
  status         ProbeStatus
  mediaType      MediaType
  container      String?      @db.VarChar(80)
  codecFactsJson Json?
  width          Int?
  height         Int?
  durationMs     Int?
  streamCount    Int?
  safeResultCode String       @db.VarChar(80)
  probedAt       DateTime     @default(now())
  storedObject   StoredObject @relation(fields: [storedObjectId], references: [id], onDelete: Restrict)

  @@unique([storedObjectId, ordinal])
  @@index([storedObjectId, probedAt(sort: Desc)])
}

// Physical table remains Asset for Phase 1 compatibility. Domain/API calls this ProjectAsset.
model Asset {
  id                       String                           @id @default(uuid()) @db.Uuid
  projectId                String                           @db.Uuid
  storedObjectId           String                           @db.Uuid
  originalFilename         String                           @db.VarChar(255)
  displayName              String                           @db.VarChar(120)
  mediaType                MediaType
  role                     AssetRole
  notes                    String?
  status                   AssetStatus                      @default(PRESERVED)
  width                    Int?
  height                   Int?
  durationMs               Int?
  inspectionWarning        String?                          @db.VarChar(120)
  removedAt                DateTime?
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  project                  Project                          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  storedObject             StoredObject                     @relation(fields: [storedObjectId], references: [id], onDelete: Restrict)
  importAttempts           AssetImportAttempt[]
  activities               ProjectActivity[]
  versionFiles             AssetVersionFile[]
  manifestItems            AssetUnderstandingManifestItem[]
  revisions                AssetUnderstandingRevision[]
  shotAssetBindings        ShotAssetBinding[]
  generationSpecReferences GenerationSpecReference[]

  @@unique([projectId, storedObjectId])
  @@unique([projectId, id])
  @@index([projectId, status, createdAt(sort: Desc)])
  @@index([projectId, status, mediaType])
  @@index([projectId, status, role])
  @@index([projectId, displayName])
}

model AssetImportBatch {
  id                 String               @id @default(uuid()) @db.Uuid
  projectId          String               @db.Uuid
  idempotencyKey     String               @db.VarChar(120)
  requestedItemCount Int
  status             ImportBatchStatus    @default(PROCESSING)
  createdAt          DateTime             @default(now())
  completedAt        DateTime?
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  attempts           AssetImportAttempt[]

  @@unique([projectId, idempotencyKey])
  @@unique([projectId, id])
  @@index([projectId, createdAt(sort: Desc)])
}

model AssetImportAttempt {
  id                String              @id @default(uuid()) @db.Uuid
  projectId         String              @db.Uuid
  batchId           String?             @db.Uuid
  itemIndex         Int?
  status            ImportAttemptStatus @default(TERMINAL)
  submittedFilename String              @db.VarChar(255)
  submittedByteSize BigInt?
  detectedMimeType  String?             @db.VarChar(120)
  sha256            String?             @db.Char(64)
  requestedRole     AssetRole
  outcome           ImportOutcome
  resultCode        String              @db.VarChar(80)
  assetId           String?             @db.Uuid
  createdAt         DateTime            @default(now())
  completedAt       DateTime?
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  batch             AssetImportBatch?   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  asset             Asset?              @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([batchId, itemIndex])
  @@index([projectId, createdAt(sort: Desc)])
}

model ProjectActivity {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @db.Uuid
  assetId   String?      @db.Uuid
  type      ActivityType
  summary   String       @db.VarChar(160)
  createdAt DateTime     @default(now())
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  asset     Asset?       @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt(sort: Desc)])
}

model ProductionAsset {
  id               String                   @id @default(uuid()) @db.Uuid
  projectId        String                   @db.Uuid
  type             ProductionAssetType
  name             String                   @db.VarChar(120)
  normalizedName   String                   @db.VarChar(120)
  slug             String?                  @db.VarChar(120)
  status           ProductionAssetStatus    @default(ACTIVE)
  currentVersionId String?                  @db.Uuid
  rowVersion       Int                      @default(1)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versions         ProductionAssetVersion[] @relation("ProductionAssetVersions")
  currentVersion   ProductionAssetVersion?  @relation("ProductionAssetCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  characterProfile CharacterProfile?

  @@unique([projectId, type, normalizedName])
  @@unique([projectId, id])
  @@index([projectId, type, status, name])
}

model ProductionAssetVersion {
  id                       String                       @id @default(uuid()) @db.Uuid
  projectId                String                       @db.Uuid
  productionAssetId        String                       @db.Uuid
  versionNumber            Int
  basedOnVersionId         String?                      @db.Uuid
  status                   ProductionAssetVersionStatus @default(DRAFT)
  displayName              String                       @db.VarChar(120)
  description              String?
  factsJson                Json?
  sourceType               BindingSourceType            @default(OWNER)
  sourceRevisionId         String?                      @db.Uuid
  publishedAt              DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  productionAsset          ProductionAsset              @relation("ProductionAssetVersions", fields: [productionAssetId], references: [id], onDelete: Restrict)
  basedOnVersion           ProductionAssetVersion?      @relation("ProductionAssetVersionLineage", fields: [basedOnVersionId], references: [id], onDelete: Restrict)
  derivedVersions          ProductionAssetVersion[]     @relation("ProductionAssetVersionLineage")
  currentForAsset          ProductionAsset[]            @relation("ProductionAssetCurrentVersion")
  files                    AssetVersionFile[]
  fromRelations            ProductionAssetRelation[]    @relation("ProductionAssetRelationFrom")
  toRelations              ProductionAssetRelation[]    @relation("ProductionAssetRelationTo")
  characterVersions        CharacterVersion[]
  stateComponents          CharacterStateComponent[]
  shotAssetBindings        ShotAssetBinding[]
  generationSpecReferences GenerationSpecReference[]

  @@unique([productionAssetId, versionNumber])
  @@unique([projectId, id])
  @@index([projectId, status])
}

model AssetVersionFile {
  id                       String                    @id @default(uuid()) @db.Uuid
  projectId                String                    @db.Uuid
  productionAssetVersionId String                    @db.Uuid
  projectAssetId           String                    @db.Uuid
  referenceUsage           ReferenceUsage
  viewpoint                Viewpoint                 @default(UNSPECIFIED)
  shotScale                ShotScale                 @default(UNSPECIFIED)
  regionJson               Json?
  qualityFactsJson         Json?
  approvalStatus           BindingApprovalStatus     @default(PENDING)
  isPreferred              Boolean                   @default(false)
  sourceType               BindingSourceType         @default(OWNER)
  sourceRevisionId         String?                   @db.Uuid
  status                   BindingStatus             @default(ACTIVE)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  productionAssetVersion   ProductionAssetVersion    @relation(fields: [productionAssetVersionId], references: [id], onDelete: Restrict)
  projectAsset             Asset                     @relation(fields: [projectAssetId], references: [id], onDelete: Restrict)
  shotAssetBindings        ShotAssetBinding[]
  generationSpecReferences GenerationSpecReference[]

  @@unique([productionAssetVersionId, projectAssetId, referenceUsage, viewpoint, shotScale])
  @@unique([projectId, id])
  @@index([projectId, referenceUsage, status, approvalStatus])
  @@index([projectAssetId, status])
}

model ProductionAssetRelation {
  id                 String                 @id @default(uuid()) @db.Uuid
  projectId          String                 @db.Uuid
  fromAssetVersionId String                 @db.Uuid
  toAssetVersionId   String                 @db.Uuid
  relationType       AssetRelationType
  status             RelationStatus         @default(ACTIVE)
  sourceType         BindingSourceType      @default(OWNER)
  sourceRevisionId   String?                @db.Uuid
  validFrom          DateTime?
  validTo            DateTime?
  createdAt          DateTime               @default(now())
  fromAssetVersion   ProductionAssetVersion @relation("ProductionAssetRelationFrom", fields: [fromAssetVersionId], references: [id], onDelete: Restrict)
  toAssetVersion     ProductionAssetVersion @relation("ProductionAssetRelationTo", fields: [toAssetVersionId], references: [id], onDelete: Restrict)

  @@unique([fromAssetVersionId, toAssetVersionId, relationType])
  @@unique([projectId, id])
  @@index([projectId, status])
}

model CharacterProfile {
  id                String             @id @default(uuid()) @db.Uuid
  projectId         String             @db.Uuid
  productionAssetId String             @unique @db.Uuid
  canonicalName     String             @db.VarChar(120)
  identityNotes     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  productionAsset   ProductionAsset    @relation(fields: [productionAssetId], references: [id], onDelete: Restrict)
  versions          CharacterVersion[]

  @@unique([projectId, id])
  @@index([projectId, canonicalName])
}

model CharacterVersion {
  id                       String                       @id @default(uuid()) @db.Uuid
  projectId                String                       @db.Uuid
  characterProfileId       String                       @db.Uuid
  productionAssetVersionId String                       @db.Uuid
  versionNumber            Int
  status                   ProductionAssetVersionStatus @default(DRAFT)
  identityFactsJson        Json?
  basedOnVersionId         String?                      @db.Uuid
  publishedAt              DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  characterProfile         CharacterProfile             @relation(fields: [characterProfileId], references: [id], onDelete: Restrict)
  productionAssetVersion   ProductionAssetVersion       @relation(fields: [productionAssetVersionId], references: [id], onDelete: Restrict)
  basedOnVersion           CharacterVersion?            @relation("CharacterVersionLineage", fields: [basedOnVersionId], references: [id], onDelete: Restrict)
  derivedVersions          CharacterVersion[]           @relation("CharacterVersionLineage")
  stateVersions            CharacterStateVersion[]

  @@unique([characterProfileId, versionNumber])
  @@unique([projectId, id])
  @@index([projectId, status])
}

model CharacterStateVersion {
  id                       String                       @id @default(uuid()) @db.Uuid
  projectId                String                       @db.Uuid
  characterVersionId       String                       @db.Uuid
  stateKey                 String                       @db.VarChar(80)
  versionNumber            Int
  name                     String                       @db.VarChar(120)
  status                   ProductionAssetVersionStatus @default(DRAFT)
  description              String?
  basedOnStateVersionId    String?                      @db.Uuid
  publishedAt              DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  characterVersion         CharacterVersion             @relation(fields: [characterVersionId], references: [id], onDelete: Restrict)
  basedOnStateVersion      CharacterStateVersion?       @relation("CharacterStateLineage", fields: [basedOnStateVersionId], references: [id], onDelete: Restrict)
  derivedStateVersions     CharacterStateVersion[]      @relation("CharacterStateLineage")
  components               CharacterStateComponent[]
  shotAssetBindings        ShotAssetBinding[]
  generationSpecReferences GenerationSpecReference[]

  @@unique([characterVersionId, stateKey, versionNumber])
  @@unique([projectId, id])
  @@index([projectId, status])
}

model CharacterStateComponent {
  id                      String                      @id @default(uuid()) @db.Uuid
  projectId               String                      @db.Uuid
  characterStateVersionId String                      @db.Uuid
  slotType                CharacterStateComponentSlot
  componentAssetVersionId String                      @db.Uuid
  slotKey                 String                      @default("") @db.VarChar(80)
  sortOrder               Int                         @default(0)
  required                Boolean                     @default(true)
  createdAt               DateTime                    @default(now())
  characterStateVersion   CharacterStateVersion       @relation(fields: [characterStateVersionId], references: [id], onDelete: Restrict)
  componentAssetVersion   ProductionAssetVersion      @relation(fields: [componentAssetVersionId], references: [id], onDelete: Restrict)

  @@unique([characterStateVersionId, slotType, slotKey])
  @@unique([projectId, id])
  @@index([projectId, slotType])
}

model AssetUnderstandingManifest {
  id            String                           @id @default(uuid()) @db.Uuid
  projectId     String                           @db.Uuid
  manifestHash  String                           @unique @db.Char(64)
  providerId    String                           @db.VarChar(80)
  modelId       String                           @db.VarChar(160)
  taskType      String                           @db.VarChar(80)
  promptVersion String                           @db.VarChar(80)
  schemaVersion String                           @db.VarChar(80)
  maxCalls      Int                              @default(1)
  assetCount    Int
  totalByteSize BigInt
  expiresAt     DateTime
  createdAt     DateTime                         @default(now())
  project       Project                          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  items         AssetUnderstandingManifestItem[]
  grants        AiCallGrant[]
  runs          AssetUnderstandingRun[]

  @@unique([projectId, id])
  @@index([projectId, createdAt(sort: Desc)])
}

model AssetUnderstandingManifestItem {
  id         String                     @id @default(uuid()) @db.Uuid
  manifestId String                     @db.Uuid
  position   Int
  slot       String                     @db.VarChar(4)
  assetId    String                     @db.Uuid
  sha256     String                     @db.Char(64)
  byteSize   BigInt
  mediaType  MediaType
  manifest   AssetUnderstandingManifest @relation(fields: [manifestId], references: [id], onDelete: Restrict)
  asset      Asset                      @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([manifestId, position])
  @@unique([manifestId, slot])
  @@unique([manifestId, assetId])
}

model AiCallGrant {
  id             String                     @id @default(uuid()) @db.Uuid
  manifestId     String                     @db.Uuid
  operation      String                     @db.VarChar(80)
  providerId     String                     @db.VarChar(80)
  modelId        String                     @db.VarChar(160)
  maxCalls       Int                        @default(1)
  idempotencyKey String                     @unique @db.VarChar(120)
  status         AnalysisGrantStatus        @default(CREATED)
  expiresAt      DateTime
  createdAt      DateTime                   @default(now())
  consumedAt     DateTime?
  manifest       AssetUnderstandingManifest @relation(fields: [manifestId], references: [id], onDelete: Restrict)
  run            AssetUnderstandingRun?

  @@index([status, expiresAt])
}

model AssetUnderstandingRun {
  id             String                       @id @default(uuid()) @db.Uuid
  projectId      String                       @db.Uuid
  manifestId     String                       @db.Uuid
  grantId        String                       @unique @db.Uuid
  idempotencyKey String                       @db.VarChar(120)
  status         AnalysisRunStatus            @default(QUEUED)
  resultCode     String?                      @db.VarChar(80)
  claimedBy      String?                      @db.VarChar(120)
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime                     @default(now())
  project        Project                      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  manifest       AssetUnderstandingManifest   @relation(fields: [manifestId], references: [id], onDelete: Restrict)
