# Read-only defaults. LIVE remains disabled unless explicitly set to exactly 1.
COMFYUI_BASE_URL=http://127.0.0.1:8188
PROJECT_CAPABILITY_REGISTRY_OPERATOR_ENABLED=false
COMFYUI_LIVE_ENABLED=0
CODEX_MANAGER_LIVE_ENABLED=0
OPENAI_LIVE_ENABLED=0
SPIKE_DATA_DIR=./var/spike
WORKFLOW_REGISTRY_PATH=./workflows/registry.json

# Phase 1 Project/Asset local product state. Binary originals stay outside PostgreSQL.
DATABASE_URL=postgresql://comfyuiflow:comfyuiflow@127.0.0.1:5448/comfyuiflow
PROJECT_ASSET_STORAGE_DIR=./var/project-assets
PROJECT_ASSET_MAX_BYTES=262144000
PROJECT_ASSET_MAX_BATCH=20

# Phase 2 Asset Understanding. Fake Provider is internal; any non-fake provider remains disabled.
ASSET_UNDERSTANDING_LIVE_ENABLED=false
ASSET_UNDERSTANDING_PROVIDER=fake
ASSET_UNDERSTANDING_MODEL=asset-understanding-fake-v1
ASSET_UNDERSTANDING_MAX_IMAGE_BYTES=10485760
ASSET_UNDERSTANDING_MAX_BATCH_BYTES=41943040
ASSET_UNDERSTANDING_MANIFEST_TTL_MS=300000
ASSET_UNDERSTANDING_LEASE_MS=60000

# Phase 3 formal Storyboard binding stays closed until Phase 2 convergence evidence passes.
PHASE2_STORYBOARD_BINDINGS_ENABLED=false

# Phase 5-6 generation execution. Fake is the automated/default path and makes zero external calls.
GENERATION_PROVIDER_PROFILE=fake-video-v1
PROJECT_GENERATION_LIVE_ENABLED=false
REAL_GENERATION_ENABLED=false
PROJECT_GENERATION_ENGINE=workflow-agent-v1
PROJECT_COMFYUI_MCP_READY=false
PROJECT_WORKER_READY=false
PROJECT_GENERATION_QUOTA_READY=false
PROJECT_GENERATION_REGISTRY_PATH=./generation/registry.json
PROJECT_GENERATED_STORAGE_DIR=./var/project-generated
PROJECT_GENERATED_MAX_BYTES=524288000
PROJECT_WORKER_POLL_INTERVAL_MS=1000
# Set only for tests or an intentional single worker turn; normal development stays resident.
PROJECT_WORKER_ONCE=false

# Feature 016 V3 AI QA. This is a second, independent paid-call boundary. Keep disabled until
# a fresh action-time authorization has disclosed current operator-provided pricing.
VIDEO_QA_LIVE_ENABLED=false
VIDEO_QA_PROVIDER_PROFILE=codexmanager-local
VIDEO_QA_MODEL_ID=gpt-5.4
VIDEO_QA_BILLING_CHANNEL=
VIDEO_QA_MAX_COST_MICROS=
VIDEO_QA_PRICE_EFFECTIVE_AT=
VIDEO_QA_PRICE_EXPIRES_AT=

# Optional supervisor input: an existing local install only. No packages, nodes, or models install.
COMFYUI_INSTALL_DIR=
COMFYUI_PYTHON=python3

# Phase 14 AI Director. Both external profiles use exact model gpt-5.6-terra.
# Price facts are operator-owned snapshots and must be refreshed before expiry.
PROJECT_STORYBOARD_DIRECTOR_LIVE_ENABLED=false
STORYBOARD_DIRECTOR_CODEXMANAGER_BILLING_CHANNEL=
STORYBOARD_DIRECTOR_CODEXMANAGER_MAX_COST_USD=
STORYBOARD_DIRECTOR_CODEXMANAGER_PRICE_EFFECTIVE_AT=
STORYBOARD_DIRECTOR_CODEXMANAGER_PRICE_EXPIRES_AT=
STORYBOARD_DIRECTOR_OPENAI_BILLING_CHANNEL=
STORYBOARD_DIRECTOR_OPENAI_MAX_COST_USD=
STORYBOARD_DIRECTOR_OPENAI_PRICE_EFFECTIVE_AT=
STORYBOARD_DIRECTOR_OPENAI_PRICE_EXPIRES_AT=

# Phase 13 continuity keyframes. Fake remains the default zero-call path.
# LIVE stays fail-closed until every capability and current price fact is explicitly verified.
PROJECT_KEYFRAME_LIVE_ENABLED=false
CODEX_MANAGER_BASE_URL=http://127.0.0.1:48760/v1
PROJECT_KEYFRAME_EDIT_PATH=/images/edits
PROJECT_KEYFRAME_MODEL_ID=gpt-image-2
PROJECT_KEYFRAME_MODEL_SNAPSHOT=
PROJECT_KEYFRAME_IMAGE_EDITING=false
PROJECT_KEYFRAME_MULTI_REFERENCE=false
PROJECT_KEYFRAME_HIGH_FIDELITY_INPUT=false
PROJECT_KEYFRAME_MAX_REFERENCES=0
PROJECT_KEYFRAME_ESTIMATED_USD_PER_IMAGE=
PROJECT_KEYFRAME_PRICE_AS_OF=
PROJECT_KEYFRAME_PRICE_EXPIRES_AT=
PROJECT_KEYFRAME_TIMEOUT_MS=120000

# Environment-only secrets. Never commit values.
COMFYUI_API_KEY=
# Optional alternative for short-lived frontend auth; prefer COMFYUI_API_KEY for CLI use.
COMFYUI_AUTH_TOKEN=
CODEX_MANAGER_API_KEY=
OPENAI_API_KEY=
